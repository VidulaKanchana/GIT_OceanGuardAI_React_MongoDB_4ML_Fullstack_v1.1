# ====================================================================
# OceanGuard AI — Environmental Configuration Template
# ====================================================================

# Environment Name: development | testing | production
ENVIRONMENT=development

# API Settings
PROJECT_NAME="OceanGuard AI Fullstack Platform"
API_V1_STR=/api/v1

# Security & JWT Tokens
# Generating secure key: openssl rand -hex 32
SECRET_KEY=oceanguard_super_secure_jwt_secret_marine_ai_2026_key_xyz_9982
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# In local development without MongoDB daemon running, connection.py automatically falls back to in-memory mongomock.
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=oceanguard_db

# CORS Allowed Origins (JSON array of strings)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Model Artifact Paths
C1_MODEL_PATH=model_artifacts/c1/best_c1_model.pt
C1_PREPROCESSOR_PATH=model_artifacts/c1/c1_preprocessor.joblib
C2_MODEL_PATH=model_artifacts/c2/best_c2_model.pt
C2_METADATA_PATH=model_artifacts/c2/graph_metadata.json
C2_NORM_ADJ_PATH=model_artifacts/c2/norm_adj.npy
C4_MODEL_PATH=model_artifacts/c4/best_c4_model.pt
C4_SCALER_PATH=model_artifacts/c4/scaler_params.json
