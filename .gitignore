# ====================================================================
# OceanGuard AI — Comprehensive Root .gitignore
# ====================================================================

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
*.venv

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.pyo

# Node & Frontend Build Artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.tsbuildinfo
frontend/*.tsbuildinfo

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.tmp
*.temp

# IDE & OS Metadata
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Database & Container Data
mongo_data/
*.sqlite3
*.db
